<?xml version="1.0"?>
<configuration>
	<connectionStrings>
		<add name="PlacementDB"
     connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=PlacementDB;Integrated Security=True;Encrypt=False;TrustServerCertificate=True"
     providerName="System.Data.SqlClient" />
	</connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>
</configuration>
